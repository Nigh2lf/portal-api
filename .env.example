# ============================================================================
# Django
# ============================================================================
SECRET_KEY=change-me-use-a-long-random-value
DEBUG=True
# Hosts permitidos (csv). Ex.: api.meusite.com,admin.meusite.com
# No Railway, healthcheck.railway.app é incluído automaticamente (settings.py).
ALLOWED_HOSTS=localhost,127.0.0.1
# Origens confiáveis para CSRF (csv) — obrigatório com HTTPS atrás de proxy
CSRF_TRUSTED_ORIGINS=
# Nome do projeto. Aparece no Django Admin, Swagger e nos e-mails.
PROJECT_NAME=Project

# ============================================================================
# OpenAPI / Swagger (drf-spectacular)
# ============================================================================
# Se vazios, caem para PROJECT_NAME / defaults.
API_TITLE=
API_DESCRIPTION=API documentation
API_VERSION=1.0.0
# Versões da API liberadas (DRF URLPathVersioning). CSV. Default: v1.
# Ao subir uma v2, adicione "v1,v2".
API_ALLOWED_VERSIONS=v1

# ============================================================================
# CORS
# ============================================================================
# Em produção MANTENHA False e use CORS_ALLOWED_ORIGINS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=False

# ============================================================================
# JWT
# ============================================================================
JWT_ACCESS_MINUTES=120
JWT_REFRESH_MINUTES=43200 # 30 dias

# ============================================================================
# Throttling (DRF)
# ============================================================================
THROTTLE_ANON=100/min
THROTTLE_USER=5000/hour
THROTTLE_LOGIN=15/min
THROTTLE_FORGOT=5/hour
THROTTLE_CEP=180/hour

# ============================================================================
# HTTPS / Headers (aplicados quando DEBUG=False)
# ============================================================================
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ============================================================================
# Database
# ============================================================================
DB_ENGINE=django.db.backends.mysql
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=your_database_host
DB_PORT=3306

# ============================================================================
# AWS S3 (opcional — sem isso usa filesystem local)
# ============================================================================
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=sa-east-1
# Nenhuma ACL é enviada no upload: o bucket usa "Bucket owner enforced" (ACLs
# desabilitadas). Acesso público é controlado por bucket policy, não por ACL.
# True gera URLs assinadas para o storage privado
AWS_QUERYSTRING_AUTH=True

# ============================================================================
# E-mail transacional — Brevo (classe de serviço em core/services/email)
# ============================================================================
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
EMAIL_API_TIMEOUT=10

# ============================================================================
# CEP — ViaCEP direto, resultado gravado na tabela PostalCode
# ============================================================================
VIACEP_URL=https://viacep.com.br/ws/{cep}/json/
CEP_API_TIMEOUT=10
CEP_CACHE_DAYS=365

# ============================================================================
# E-mails (templates / branding)
# ============================================================================
URL_FORGOT_PASSWORD=https://your-frontend.com/reset-password
EMAIL_SENDER_NAME=
EMAIL_SENDER_ADDRESS=no-reply@yourproject.com
EMAIL_SUPPORT_ADDRESS=
EMAIL_BRAND_NAME=
EMAIL_PRIMARY_COLOR="#111827"
# Logo no header dos e-mails. Prefira cadastrar PublicAsset(name="email_logo") via /admin/.
EMAIL_LOGO_URL=

# ============================================================================
# Verificação de e-mail (opt-in)
# True  -> cadastro envia código; endpoints send-verification-code / verify-email ATIVOS
# False -> cadastro envia welcome direto;  endpoints retornam 404
# ============================================================================
EMAIL_VERIFICATION_REQUIRED=False
EMAIL_VERIFICATION_CODE_TTL_MIN=60

# ============================================================================
# MFA no Django Admin (django-otp)
# True  -> /admin/ exige TOTP/static token (OTPAdminSite). Cadastre device
#          em /admin/otp_totp/totpdevice/ ou via `manage.py addstatictoken <user>`.
# False -> admin padrão, sem MFA. Apps/migrations do otp continuam presentes.
# ============================================================================
ADMIN_MFA_ENABLED=False

# ============================================================================
# Internacionalização
# ============================================================================
LANGUAGE_CODE=pt-br
TIME_ZONE=America/Sao_Paulo

# ============================================================================
# Request logging (RequestLoggerMiddleware -> tabela LogRequest)
# Não há agendador: `python manage.py purge_logs` apaga o que passou da retenção.
# ============================================================================
# Liga/desliga o middleware
LOG_REQUESTS_ENABLED=True
# Dias mantidos pelo `purge_logs`
LOG_REQUESTS_RETENTION_DAYS=30
# Dias de buscas do site (SearchLog) mantidos pelo `purge_logs`; "mais procurados" lê os últimos 90
SEARCH_LOG_RETENTION_DAYS=120
# Bytes máximos do body parseado; acima disso vira "<truncated>"
LOG_REQUESTS_MAX_BODY=10000
# Prefixos de URL ignorados pelo log (csv)
LOG_REQUESTS_EXCLUDE_PATHS=/admin/,/static/,/media/,/favicon.ico,/api/v1/health,/api/v1/schema,/api/v1/docs,/api/v1/redoc

# ============================================================================
# Auditoria de mudanças em models (signals -> tabela LogModelChange)
# Captura CREATE/UPDATE/DELETE em qualquer caminho (Admin, ORM, commands, API).
# `python manage.py purge_logs` apaga o que passou da retenção.
# ============================================================================
MODEL_AUDIT_ENABLED=False
MODEL_AUDIT_RETENTION_DAYS=30
# Models auditados (csv "app_label.ModelName"). Default cobre só usuários.
MODEL_AUDIT_MODELS=core.User

# ============================================================================
# Content Security Policy (csv por diretiva; aspas precisam estar no valor)
# Deixe vazio para usar os defaults seguros do settings.py
# ============================================================================
CSP_DEFAULT_SRC=
CSP_SCRIPT_SRC=
CSP_STYLE_SRC=
CSP_FONT_SRC=
CSP_IMG_SRC=
CSP_CONNECT_SRC=
CSP_FRAME_ANCESTORS=

# ============================================================================
# Banco do portal legado (PHP) — somente leitura, usado por `manage.py import_legacy`
# Deixe DB_PORTAL_ANTIGO_HOST vazio para não registrar a conexão "legacy".
# ============================================================================
DB_PORTAL_ANTIGO_ENGINE=django.db.backends.mysql
DB_PORTAL_ANTIGO_NAME=portal
DB_PORTAL_ANTIGO_USER=
DB_PORTAL_ANTIGO_PASSWORD=
DB_PORTAL_ANTIGO_HOST=
DB_PORTAL_ANTIGO_PORT=3306

# ============================================================================
# Cache das leituras públicas (core/services/public_cache.py)
# ============================================================================
PUBLIC_CACHE_ENABLED=true
# Redis (opcional). Sem ela, o cache usa memória local (e versões em arquivo).
# Railway: definida automaticamente via ${{Redis.REDIS_URL}}
# Local via túnel (railway connect Redis --tunnel-only): redis://default:SENHA@localhost:PORTA
REDIS_URL=
# Fallback sem REDIS_URL: dados em memória do processo; versões em arquivo local (compartilhado pelos workers).
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_MAX_ENTRIES=5000
CACHE_VERSIONS_BACKEND=django.core.cache.backends.filebased.FileBasedCache
# CACHE_VERSIONS_LOCATION=/tmp/portal-api-cache-versions
# Rota do portal-web que expira as tags do Next; o segredo é o mesmo REVALIDATE_SECRET do site.
SITE_REVALIDATE_URL=http://localhost:3000/api/revalidate
SITE_REVALIDATE_SECRET=
SITE_REVALIDATE_TIMEOUT=5
# Estatísticas do site gravadas em thread de fundo.
DEFERRED_WRITES_ENABLED=true
# GETs destes prefixos não vão para o LogRequest (escritas continuam). Vazio = loga tudo.
LOG_REQUESTS_SKIP_READ_PATHS=
# Conexão com o banco reaproveitada entre requisições (segundos).
DB_CONN_MAX_AGE=60
